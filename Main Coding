import argparse
import cv2
import torch
import os
import sys
from pathlib import Path

CLASS_NAMES = ["arduino_uno", "servo_motor", "motor_driver"]


def load_model(weights_path, device):
    print(f"Loading model from {weights_path} on device: {device}")
    model = torch.hub.load(
        "ultralytics/yolov5",
        "custom",
        path=weights_path,
        force_reload=False
    )
    model.to(device)
    model.eval()
    return model


def process_image(model, img_path, output_dir, view_img, save_txt, save_conf):
    img = cv2.imread(img_path)
    if img is None:
        print(f"WARNING: Could not read image: {img_path}")
        return

    results = model(img)
    annotated = results.render()[0]
    out_path = output_dir / Path(img_path).name
    cv2.imwrite(str(out_path), annotated)

    detections = results.pandas().xyxy[0]
    print(f"{Path(img_path).name}: {len(detections)} detection(s)")
    for _, det in detections.iterrows():
        print(f"  - {det['name']}: {det['confidence']:.2f} @ [{det['xmin']:.0f},{det['ymin']:.0f},{det['xmax']:.0f},{det['ymax']:.0f}]")

    if view_img:
        cv2.imshow("Detection", annotated)
        cv2.waitKey(0)
        cv2.destroyAllWindows()

    if save_txt:
        label_path = output_dir / (Path(img_path).stem + ".txt")
        h, w = img.shape[:2]
        with open(label_path, "w") as f:
            for _, det in detections.iterrows():
                cls_idx = CLASS_NAMES.index(det["name"]) if det["name"] in CLASS_NAMES else 0
                cx = ((det["xmin"] + det["xmax"]) / 2) / w
                cy = ((det["ymin"] + det["ymax"]) / 2) / h
                bw = (det["xmax"] - det["xmin"]) / w
                bh = (det["ymax"] - det["ymin"]) / h
                line = f"{cls_idx} {cx:.6f} {cy:.6f} {bw:.6f} {bh:.6f}"
                if save_conf:
                    line += f" {det['confidence']:.4f}"
                f.write(line + "
")


def run_detection(model, source, conf_thres, iou_thres, view_img, save_txt, save_conf, device):
    output_dir = Path("runs/detect")
    output_dir.mkdir(parents=True, exist_ok=True)

    source = str(source)
    is_webcam = source.isnumeric()
    is_video = source.lower().endswith((".mp4", ".avi", ".mov", ".mkv"))
    is_image = source.lower().endswith((".jpg", ".jpeg", ".png", ".bmp", ".tiff"))
    is_folder = os.path.isdir(source)

    model.conf = conf_thres
    model.iou = iou_thres

    if is_webcam or is_video:
        cap = cv2.VideoCapture(int(source) if is_webcam else source)
        if not cap.isOpened():
            print(f"ERROR: Cannot open source {source}")
            sys.exit(1)

        frame_count = 0
        print("Starting detection. Press Q to quit...")

        while True:
            ret, frame = cap.read()
            if not ret:
                break

            results = model(frame)
            frame_count += 1
            annotated = results.render()[0]

            detections = results.pandas().xyxy[0]
            if len(detections) > 0:
                print(f"Frame {frame_count}: {len(detections)} detection(s)")
                for _, det in detections.iterrows():
                    print(f"  - {det['name']}: {det['confidence']:.2f}")

            if view_img:
                cv2.imshow("YOLOv5 Detection", annotated)
                if cv2.waitKey(1) & 0xFF == ord("q"):
                    break

        cap.release()
        cv2.destroyAllWindows()

    elif is_image:
        process_image(model, source, output_dir, view_img, save_txt, save_conf)

    elif is_folder:
        image_exts = (".jpg", ".jpeg", ".png", ".bmp", ".tiff")
        images = [f for f in os.listdir(source) if f.lower().endswith(image_exts)]
        print(f"Found {len(images)} images in {source}")
        for img_file in images:
            process_image(model, os.path.join(source, img_file), output_dir, view_img, save_txt, save_conf)
    else:
        print(f"ERROR: Unsupported source: {source}")
        sys.exit(1)

    print(f"
Detection complete. Results saved to: {output_dir}")


def parse_args():
    parser = argparse.ArgumentParser(description="YOLOv5 inference for component detection")
    parser.add_argument("--weights", type=str, default="best.pt", help="Path to model weights (.pt)")
    parser.add_argument("--source", type=str, default="data/images", help="Image, video, folder, or webcam index")
    parser.add_argument("--conf-thres", type=float, default=0.25, help="Confidence threshold (default: 0.25)")
    parser.add_argument("--iou-thres", type=float, default=0.45, help="IoU NMS threshold (default: 0.45)")
    parser.add_argument("--device", type=str, default="", help="CUDA device index or cpu")
    parser.add_argument("--view-img", action="store_true", help="Display results in window")
    parser.add_argument("--save-txt", action="store_true", help="Save detection labels to .txt")
    parser.add_argument("--save-conf", action="store_true", help="Include confidence in label files")
    return parser.parse_args()


def main():
    args = parse_args()

    if not os.path.exists(args.weights):
        print(f"ERROR: Weights file not found: {args.weights}")
        print("Provide a trained YOLOv5 weights file via --weights")
        sys.exit(1)

    if args.device:
        device = torch.device(f"cuda:{args.device}" if args.device.isdigit() else args.device)
    else:
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")

    model = load_model(args.weights, device)
    run_detection(
        model=model,
        source=args.source,
        conf_thres=args.conf_thres,
        iou_thres=args.iou_thres,
        view_img=args.view_img,
        save_txt=args.save_txt,
        save_conf=args.save_conf,
        device=device
    )


if __name__ == "__main__":
    main()
